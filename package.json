{
  "name": "portfolio-tracker-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Casablanca (MAD) portfolio tracker - v2 (modular core, tested, encrypted backups).",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "concat": "node scripts/concat.mjs",
    "dev": "npm run concat && vite",
    "build": "npm run concat && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
